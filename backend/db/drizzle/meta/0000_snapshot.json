  "views": {
    "public.employee_balances": {
      "name": "employee_balances",
      "schema": "public",
      "columns": {
        "employee_id": {
          "name": "employee_id",
          "type": "bigint",
          "primaryKey": false,
          "notNull": false
        },
        "balance": {
          "name": "balance",
          "type": "numeric",
          "primaryKey": false,
          "notNull": false
        }
      },
      "isExisting": false,
      "definition": "SELECT e.id AS employee_id, COALESCE(g.total_granted, 0::numeric) - COALESCE(t.total_debited, 0::numeric) AS balance FROM employees e LEFT JOIN ( SELECT credit_grants.employee_id, sum(credit_grants.amount) AS total_granted FROM credit_grants GROUP BY credit_grants.employee_id) g ON g.employee_id = e.id LEFT JOIN ( SELECT tr.employee_id, sum(tr.amount) AS total_debited FROM transactions tr LEFT JOIN transaction_reversals rv ON rv.transaction_id = tr.id WHERE rv.id IS NULL GROUP BY tr.employee_id) t ON t.employee_id = e.id",
      "materialized": false
    }
  },
